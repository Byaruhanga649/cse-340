<%- include('partials/header', { title: title }) %>

    <section class="projects-section">

        <h1>
            <%= title %>
        </h1>

        <p>Welcome to our Service Projects page.</p>

        <p>
            Discover projects that help improve our community
            through service and cooperation.
        </p>

        <h2>Upcoming Service Projects</h2>

        <div class="project-grid">

            <% if (projects && projects.length> 0) { %>

                <% projects.forEach((project)=> { %>

                    <article class="project-card">

                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p>
                            <%= project.description %>
                        </p>

                        <p>
                            <strong>Organization:</strong>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>

                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>

                        <p>
                            <strong>Date:</strong>
                            <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                                day: 'numeric' , timeZone: 'UTC' }) %>
                        </p>

                    </article>

                    <% }); %>

                        <% } else { %>

                            <p>No upcoming service projects are currently available.</p>

                            <% } %>

        </div>

    </section>

    <%- include('partials/footer') %>