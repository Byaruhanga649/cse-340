<%- include('partials/header', { title: title }) %>

    <section class="organizations-section">

        <h1>
            <%= title %>
        </h1>

        <p>Welcome to the Organizations page.</p>

        <p>
            Learn more about the organizations working to make
            a difference in our community.
        </p>

        <div class="organization-grid">

            <% organizations.forEach(organization=> { %>

                <div class="organization-card">

                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"
                        class="organization-image">

                    <h2>
                        <%= organization.name %>
                    </h2>

                    <p>
                        <%= organization.description %>
                    </p>

                    <p>
                        <strong>Email:</strong>
                        <%= organization.contact_email %>
                    </p>

                </div>

                <% }); %>

        </div>

    </section>

    <%- include('partials/footer') %>