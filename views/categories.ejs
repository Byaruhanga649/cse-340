<%- include('partials/header', { title: title }) %>

    <h1>
        <%= title %>
    </h1>

    <p>Welcome to our Categories page.</p>

    <p>Explore the different categories of community service projects.</p>

    <% if (user && user.role_name==='admin' ) { %>
        <p>
            <a href="/new-category" class="button">+ Add New Category</a>
        </p>
        <% } %>

            <section class="organization-card">

                <h2>Service Project Categories</h2>

                <ul>
                    <% categories.forEach(category=> { %>

                        <li>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.category_name %>
                            </a>

                            <% if (user && user.role_name==='admin' ) { %>
                                | <a href="/edit-category/<%= category.category_id %>">
                                    Edit
                                </a>
                                <% } %>

                        </li>

                        <% }); %>
                </ul>

            </section>

            <%- include('partials/footer') %>