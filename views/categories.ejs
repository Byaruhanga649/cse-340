<%- include('partials/header', { title: title }) %>

    <h1>
        <%= title %>
    </h1>

    <p>Welcome to our Categories page.</p>

    <p>Explore the different categories of community service projects.</p>

    <section class="organization-card">
        <h2>Service Project Categories</h2>

        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <%= category.category_name %>
                </li>
                <% }); %>
        </ul>
    </section>

    <%- include('partials/footer') %>