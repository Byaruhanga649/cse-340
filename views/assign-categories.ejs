<%- include('partials/header', { title: title }) %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p>
            Select the categories that apply to
            <strong>
                <%= project.title %>
            </strong>.
        </p>

        <form action="/project/<%= project.project_id %>/assign-categories" method="POST">

            <fieldset>
                <legend>Available Categories</legend>

                <% if (categories.length> 0) { %>

                    <% categories.forEach(category=> { %>
                        <div class="form-group">
                            <input type="checkbox" id="category-<%= category.category_id %>" name="categoryIds"
                                value="<%= category.category_id %>" <%=category.assigned ? 'checked' : '' %>
                            >

                            <label for="category-<%= category.category_id %>">
                                <%= category.category_name %>
                            </label>
                        </div>
                        <% }) %>

                            <% } else { %>

                                <p>No categories are currently available.</p>

                                <% } %>
            </fieldset>

            <button type="submit">Save Categories</button>

        </form>

        <p>
            <a href="/project/<%= project.project_id %>">
                Back to Project Details
            </a>
        </p>
    </main>

    <%- include('partials/footer') %>